{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["gru1"],
  "functions": {"api/index.mjs": {"maxDuration": 60}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
